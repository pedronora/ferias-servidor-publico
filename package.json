{
  "name": "ferias-servidor-publico",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "start": "node .output/server/index.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:nuxt": "vitest run --project nuxt",
    "test:coverage": "vitest run --project unit --project nuxt --coverage",
    "test:integration": "vitest run --project integration",
    "test:e2e": "bash scripts/e2e.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@vuepic/vue-datepicker": "14.0.0",
    "csv-parse": "7.0.3",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/test-utils": "4.3.4",
    "@playwright/test": "1.64.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/eslint-plugin": "1.6.28",
    "@vue/test-utils": "2.5.1",
    "dotenv": "18.0.9",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-better-tailwindcss": "4.10.0",
    "eslint-plugin-vuejs-accessibility": "2.6.3",
    "happy-dom": "21.0.4",
    "lint-staged": "17.6.0",
    "nuxt": "4.6.3",
    "simple-git-hooks": "2.14.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "vue": "3.5.44",
    "vue-router": "5.4.0",
    "vue-tsc": "3.3.13"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "commit-msg": "pnpm exec commitlint --edit $1"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,vue}": "eslint --fix"
  }
}
