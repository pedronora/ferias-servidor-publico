# Banco
POSTGRES_USER=ferias
POSTGRES_PASSWORD=troque-por-uma-senha-hex
POSTGRES_DB=ferias
DATABASE_URL=postgresql://ferias:troque-por-uma-senha-hex@db:5432/ferias

# Sessão
NUXT_SESSION_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres

# Aplicação
NUXT_PUBLIC_APP_URL=https://ferias.nora.vc

# Admin inicial
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=troque-esta-senha

# Inicialização do container
RUN_MIGRATIONS=true
RUN_SEED=true

# Seed
SEED_DEMO_DATA=false

# Fuso usado apenas para exibição/logs; as datas de férias são civis
TZ=America/Sao_Paulo
